# Maintainer: Shane Fagan <shane@performativenonsense.com>

pkgname=liquid-devil-rgb
pkgver=1.4.2
pkgrel=1
pkgdesc="Linux I2C RGB Lighting Control for PowerColor Radeon RX 7900 XTX Liquid Devil"
arch=('any')
url="https://github.com/shanefagan/liquid_devil_linux_rgb"
license=('MIT')
depends=('python' 'python-click' 'i2c-tools')
makedepends=('uv' 'git')
source=()

pkgver() {
  cd "$startdir/../.." 2>/dev/null || cd "$startdir"
  git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || echo "1.0.0"
}

build() {
  cd "$startdir/../.." 2>/dev/null || cd "$startdir"
  uv build
}

package() {
  cd "$startdir/../.." 2>/dev/null || cd "$startdir"
  python_ver=$(python -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
  site_dir="$pkgdir/usr/lib/python${python_ver}/site-packages"
  bin_dir="$pkgdir/usr/bin"
  service_dir="$pkgdir/usr/lib/systemd/system"
  mkdir -p "$site_dir" "$bin_dir" "$service_dir"

  cp -r src/liquid_devil_rgb "$site_dir/"
  
  cat << 'EOF' > "$bin_dir/liquid-devil-rgb"
#!/usr/bin/env python3
from liquid_devil_rgb.cli import main
if __name__ == '__main__':
    main()
EOF
  chmod +x "$bin_dir/liquid-devil-rgb"

  install -Dm644 systemd/liquid-devil-sync.service "$service_dir/liquid-devil-sync.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 PROTOCOL.md "$pkgdir/usr/share/doc/$pkgname/PROTOCOL.md"
}
